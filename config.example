# Public startup template. Copy to .env and fill credentials privately.
# Provider routes and optional settings: docs/llm-gateway.md and README.md.
TELEGRAM_BOT_TOKEN=...
OWNER_TG_IDS=123456789
TZ=UTC

# Default text inference bus. Native bypass: openai, anthropic, or gemini.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=...
# Model defaults follow LLM_PROVIDER. Optional OpenRouter overrides:
# LLM_EXECUTOR_MODEL=google/gemini-2.5-flash
# LLM_ADVISOR_MODEL=anthropic/claude-sonnet-4.6

# Native tools, vision and grounding default to Gemini alongside OpenRouter text.
# Required when those capabilities are used:
# GEMINI_API_KEY=...
# Tools/vision follow LLM_PROVIDER when it selects a direct API.
# Override independently (openai, anthropic, gemini, or openrouter):
# LLM_TOOLS_PROVIDER=gemini
# LLM_TOOLS_MODEL=gemini-2.5-flash
# LLM_VISION_PROVIDER=gemini
# LLM_VISION_MODEL=gemini-2.5-flash
# Grounding defaults to Gemini; OpenRouter search is an explicit alternative:
# LLM_SEARCH_PROVIDER=gemini
# LLM_SEARCH_MODEL=gemini-2.5-flash

# Direct routes need their own keys and native model IDs.
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# Existing GEMINI_EXECUTOR_MODEL / GEMINI_ADVISOR_MODEL aliases apply
# to Gemini routes when no corresponding LLM_*_MODEL override is set.

# KISMATIK — community memory for public Telegram groups (docs/kismatik.md).
# Off unless groups are listed. The bot must be an admin in each group, or have
# privacy mode disabled in BotFather, to see ordinary messages.
# KISMATIK_CHAT_IDS=-1001111111111,-1002222222222
# Embeddings: local (EmbeddingGemma in-process, default), gemini, or none.
# KISMATIK_EMBEDDER=local
# KISMATIK_LOCAL_MODEL=onnx-community/embeddinggemma-2-ONNX
# KISMATIK_LOCAL_DTYPE=fp32
# KISMATIK_GEMINI_EMBED_MODEL=gemini-embedding-001
# KISMATIK_EMBEDDING_DIM=256
# KISMATIK_DIGEST_INTERVAL_MIN=120
# KISMATIK_MAX_SUGGESTIONS_PER_DAY=5
# KISMATIK_MAX_ASKS_PER_USER_PER_DAY=30
