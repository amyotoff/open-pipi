{
  "name": "open-pipi",
  "version": "2.5.0",
  "description": "Open PiPi — a Telegram-first, owner-operated assistant runtime with memory, planning, and research skills",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && cp -r src/packs dist/packs && cp -r src/groundings dist/groundings",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run src/skills/features.smoke.test.ts",
    "test:watch": "vitest",
    "test:evaluator": "vitest run src/core/evaluator.test.ts",
    "backup:restore": "ts-node src/scripts/restore-runtime-backup.ts",
    "bootstrap": "ts-node src/scripts/bootstrap.ts",
    "prepare": "husky"
  },
  "keywords": [
    "telegram-bot",
    "raspberry-pi",
    "ai-assistant",
    "jeeves",
    "gemini",
    "personal-assistant"
  ],
  "author": "Amyote",
  "license": "MIT",
  "homepage": "https://github.com/amyotoff/OPENPIPIFAMILY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amyotoff/OPENPIPIFAMILY.git"
  },
  "bugs": {
    "url": "https://github.com/amyotoff/OPENPIPIFAMILY/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^1.47.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-express": "^0.62.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "telegraf": "^4.16.3"
  },
  "optionalDependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "discord.js": "^14.25.1",
    "nodemailer": "^8.0.4",
    "playwright-core": "^1.58.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.5.5",
      "undici": "^7.0.0"
    },
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "better-sqlite3",
      "protobufjs",
      "sharp"
    ]
  }
}
