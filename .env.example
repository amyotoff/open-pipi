# ==========================================
# Core runtime
# ==========================================

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
OWNER_TG_IDS=
# Optional channel-qualified owners for non-Telegram adapters, e.g.
# whatsapp:+393331234567,discord:123456789,gmail:me@example.com
OWNER_IDENTITIES=

# Optional default Telegram chat used as a seeded group anchor.
HOUSEHOLD_CHAT_ID=

# Name the assistant introduces itself with (default: PiPi).
BOT_DISPLAY_NAME=

# Extra comma-separated names the assistant responds to in group chats,
# on top of the built-in defaults (pipi, jeeves, ...). E.g. "alfred,альфред"
BOT_NAME_ALIASES=

# Temporary first-run mode only.
# Leave this false in normal operation.
BOOTSTRAP_OWNER_MODE=false

# Default pack / grounding installed for new spaces (see src/packs, src/groundings).
BOOTSTRAP_PACK=jeeves
BOOTSTRAP_GROUNDING=jeeves_personal

# Optional custom data directory.
DATA_DIR=./data

# Optional explicit SQLite path (default: <DATA_DIR>/open-pipi.db).
DB_PATH=

# How many runtime backups to keep (default: 5).
BACKUP_RETENTION_COUNT=

# Public base URL used in links to generated artifacts/pages,
# e.g. https://pipi.example.com
PIPI_PUBLIC_BASE_URL=

# Coordinates used by the weather tool (Open-Meteo).
LOCATION_LAT=0.0000
LOCATION_LON=0.0000

# Optional read-only HTTP API for inspecting tool logs.
# Keep host on 127.0.0.1 unless you intentionally expose it through a proxy.
PIPI_API_HOST=127.0.0.1
PIPI_API_PORT=0
PIPI_API_TOKEN=

# ==========================================
# Local Web client
# ==========================================

# Off by default. When on, the web client and the read-only API share one
# listener on PIPI_WEB_HOST:PIPI_WEB_PORT.
PIPI_WEB_ENABLED=false

# Keep this on loopback unless you mean to reach the assistant from other
# devices. Binding wider requires a web account to exist first, or startup
# refuses — see "pnpm web:account".
PIPI_WEB_HOST=127.0.0.1
PIPI_WEB_PORT=3000

# Read by "pnpm web:account" when creating or re-passwording an account, so the
# password never lands in shell history.
PIPI_WEB_PASSWORD=

# Runtime profile:
# auto | raspberry_pi | generic
PIPI_PLATFORM=auto

# Scheduler / date formatting timezone.
TZ=UTC

# ==========================================
# LLM / model runtime
# ==========================================

# Gemini models for the executor and the advisor passes.
GEMINI_EXECUTOR_MODEL=gemini-2.5-flash
GEMINI_ADVISOR_MODEL=gemini-3-pro-preview

# Advisor pass on/off and per-turn call budget.
PIPI_ADVISOR_ENABLED=true
PIPI_ADVISOR_MAX_CALLS_PER_TURN=1

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Remote Chromium CDP endpoint for browsing / webrun.
# The Docker setup uses http://chromium:9222 internally.
CHROMIUM_CDP_URL=http://127.0.0.1:9222

# ==========================================
# Optional additional channels
# ==========================================

# WhatsApp
WHATSAPP_ENABLED=false
# Optional primary group JID for passive group participation, e.g. 1203630...@g.us
WHATSAPP_PRIMARY_GROUP_JID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Gmail / SMTP
CONCIERGE_SMTP_HOST=
CONCIERGE_SMTP_PORT=587
CONCIERGE_SMTP_USER=
CONCIERGE_SMTP_PASS=
CONCIERGE_FROM_NAME=PiPi Bot

# Gmail inbound email-mode (optional; falls back to SMTP user/pass if omitted)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USER=
GMAIL_IMAP_PASS=
GMAIL_IMAP_POLL_MS=60000

# ==========================================
# Sandboxed tool execution (optional)
# ==========================================
# sandboxd is the container sidecar that runs untrusted pack tools
# (see Dockerfile.sandboxd and docker-compose.yml).

SANDBOXD_URL=http://sandboxd:4100
SANDBOXD_PORT=4100
# Shared secret between the bot and sandboxd.
SANDBOXD_TOKEN=
# Comma-separated container images sandboxd may run.
SANDBOXD_ALLOWED_IMAGES=
SANDBOXD_MAX_IN_FLIGHT=
SANDBOXD_MAX_TIMEOUT_MS=
SANDBOXD_MAX_MEMORY_MB=
SANDBOXD_MAX_CPU_LIMIT=
SANDBOXD_MAX_TMPFS_MB=
SANDBOXD_HOST_SCRATCH_ROOT=
SANDBOXD_CONTAINER_SCRATCH_ROOT=

# Workspace mount mapping for sandboxed pack tools.
SANDBOX_WORKSPACE_ROOT=
SANDBOX_WORKSPACE_CONTAINER_ROOT=
SANDBOX_PACK_PROJECT_ROOT=

# Local sandbox runner overrides (advanced).
PIPI_SANDBOX_RUNTIME=
PIPI_SANDBOX_TOOL_PATH=
PIPI_SANDBOX_ARGS=
PIPI_SANDBOX_CONTEXT=

# ==========================================
# Observability (optional, OpenTelemetry)
# ==========================================

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_DIAGNOSTIC_LOG_LEVEL=

# ==========================================
# Google Drive / Docs / Sheets OAuth 2.0
# ==========================================
# Create a "Web application" OAuth 2.0 client at console.cloud.google.com,
# enable the Google Drive API, Google Docs API, and Google Sheets API, then fill in below.
# GOOGLE_OAUTH_REDIRECT_URI must point to your publicly accessible server,
# e.g. https://yourserver.example.com/oauth/google/callback
# It must also be listed as an Authorized redirect URI in Google Cloud Console.
# Use /gdrive auth in Telegram to start the OAuth flow after configuring.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
